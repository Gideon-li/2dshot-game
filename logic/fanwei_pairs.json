  "reason_short": {
    "wu_fan|fuzi|banxia": {
      "zh": "附子与半夏十八反，同盏会相攻。",
      "en": "Aconite and pinellia are eighteen-incompatibles.",
      "ja": "附子と半夏は十八反、同剤不可。"
    },
    "wu_fan|generic": {
      "zh": "乌头类与半蒌贝蔹白及相反，不能同盏。",
      "en": "Aconite group vs pinellia/trichosanthes/fritillaria/ampelopsis/bletilla — locked.",
      "ja": "烏頭類と半楼貝蔹白及は相反。"
    },
    "cao_fan|generic": {
      "zh": "甘草与藻戟遂芫相反，同用会战。",
      "en": "Licorice vs algae/euphorbia group — locked.",
      "ja": "甘草と藻戟遂芫は相反。"
    },
    "lu_fan|generic": {
      "zh": "藜芦与诸参辛芍相反，禁止同盏。",
      "en": "Veratrum vs ginsengs/asarum/peony — locked.",
      "ja": "藜芦と諸参辛芍は相反。"
    },
    "wei|renshen|wulingzhi": {
      "zh": "人参最怕五灵脂，补气与破瘀相畏。",
      "en": "Ginseng fears trogopterus — nineteen fears.",
      "ja": "人参は五霊脂を畏れる。"
    },
    "wei|generic": {
      "zh": "此二味十九畏，默认不能同盏。",
      "en": "Nineteen-fears pair — default lock.",
      "ja": "十九畏の組合せ、同剤不可。"
    }
  },
  "mnemonic_fan_zh": "本草明言十八反，半蒌贝蔹及攻乌。藻戟遂芫俱战草，诸参辛芍叛藜芦。",
  "mnemonic_wei_zh": "硫黄原是火中精，朴硝一见便相争。水银莫与砒霜见，狼毒最怕密陀僧。巴豆性烈最为上，偏与牵牛不顺情。丁香莫与郁金见，牙硝难合京三棱。川乌草乌不顺犀，人参最怕五灵脂。官桂善能调冷气，若逢石脂便相欺。",
